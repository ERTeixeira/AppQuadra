# Server Configuration
APP_PORT=3333
NODE_ENV=development
LOG_LEVEL=debug

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_quadra_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public

# JWT Authentication (if implemented)
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=7200

# RabbitMQ (if implemented)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE_PREFIX=quadra

# Redis Cache (if implemented)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# External APIs
# GOOGLE_MAPS_API_KEY=
# STRIPE_API_KEY=

# Observability
SENTRY_DSN=
DATADOG_API_KEY=

# Deployment
DEPLOYMENT_ENVIRONMENT=development
